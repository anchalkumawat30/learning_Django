{
     "name": "Django Learning",
     "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
     "customizations": {
          "vscode": {
               "settings": {
                    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
               },
               "extensions": [
                    "ms-python.python"
               ]
          }
     }
}